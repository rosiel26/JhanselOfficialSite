# Supabase Configuration
# Copy this file to .env and fill in your actual values
# IMPORTANT: Never commit .env files to version control!

# Project URL from Supabase Settings → API
VITE_SUPABASE_URL=your-project-url-here

# Anon public key from Supabase Settings → API
# This key is safe to use in client-side code
VITE_SUPABASE_ANON_KEY=your-anon-key-here

# Service Role Key from Supabase Settings → API
# WARNING: This key has full access to your Supabase project!
# Only use this in server-side code or trusted environments
# Never expose this key in client-side code or commit it to version control
VITE_SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here
