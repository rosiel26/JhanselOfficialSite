# Supabase Configuration
# Copy this file to .env and fill in your actual values
# IMPORTANT: Never commit .env files to version control!

# Project URL from Supabase Settings → API
VITE_SUPABASE_URL=your-project-url-here

# Anon public key from Supabase Settings → API
# This key is safe to use in client-side code
# It has limited access controlled by Row Level Security (RLS) policies
VITE_SUPABASE_ANON_KEY=your-anon-key-here

# ==============================================================================
# SECURITY WARNING: SERVICE ROLE KEY
# ==============================================================================
# The service role key has FULL ADMIN ACCESS to your Supabase project.
# It can bypass ALL Row Level Security (RLS) policies and access/modify/delete
# any data in your database.
#
# CRITICAL: NEVER use the service role key in client-side code!
# Environment variables prefixed with VITE_ are exposed to the client bundle.
# If you set VITE_SUPABASE_SERVICE_ROLE_KEY, it will be visible in the browser!
#
# For admin operations, use one of these approaches:
# 1. Supabase Edge Functions (recommended)
# 2. Backend API (Node.js, Next.js API routes, etc.)
# 3. Server-side rendering (SSR)
#
# In Edge Functions, use Deno.env.get('SUPABASE_SERVICE_ROLE_KEY') instead.
# ==============================================================================
